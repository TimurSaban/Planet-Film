# Bu dosyayı .env olarak kopyalayın ve değerleri doldurun.
# .env dosyası git'e eklenmez.

# Sunucu
PORT=3000
NODE_ENV=development

# Oturum çerezlerini imzalamak için gizli anahtar.
# Üretimde rastgele ve uzun bir değer kullanın: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=buraya-rastgele-bir-anahtar-yazin

# Veritabanı (Aşama 1: SQLite)
# Yol, prisma/schema.prisma dosyasına göre çözümlenir -> prisma/dev.db
DATABASE_URL="file:./dev.db"

# TMDB API (Aşama 3'te kullanılacak, şimdilik boş bırakılabilir)
TMDB_API_ANAHTARI=
